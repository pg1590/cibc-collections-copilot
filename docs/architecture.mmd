flowchart TB
  SRC["Synthetic banking files: accounts, cases, contacts, promises and notes; source fields TBC"]
  subgraph L1["Layer 1: Data Product Factory"]
    LOAD["Import files, remove duplicates and check data | Python / Polars / DuckDB"]
    MAP["AI suggests field mappings; HUMAN data reviewer approves"]
    MATCH["Match customer IDs; HUMAN reviews uncertain matches"]
    VIEW["One customer view (C360), with sources and dates | CockroachDB"]
    LOAD --> MAP --> MATCH --> VIEW
  end
  SRC --> LOAD
  subgraph L2["Layer 2: Plain-English questions"]
    QUESTION["AI understands question"]
    CHECK["Server checks supported measures and user access"]
    ANSWER["Approved read-only SQL query; show answer, SQL, source and date; refuse unsupported requests"]
    QUESTION --> CHECK --> ANSWER
  end
  subgraph L3["Layer 3: Agent assist - one use case"]
    RECORDS["Read assigned customer's permitted records"]
    BRIEF["AI finds possible hardship; fixed brief shows verified facts and sources"]
    REVIEW["HUMAN agent reviews; separate specialist checks hardship referral"]
    APPROVE["Recheck permissions, record approval and simulate action"]
    RECORDS --> BRIEF --> REVIEW --> APPROVE
  end
  VIEW --> CHECK
  VIEW --> RECORDS
  UI["Next.js user screen; FastAPI service; language model provider TBC"] --> QUESTION
  UI --> RECORDS
  ANSWER --> UI
  REVIEW --> UI
  GOV["All layers: access checks, no protected attributes, human review, action records and monitoring"]
  GOV -.-> L1
  GOV -.-> L2
  GOV -.-> L3
