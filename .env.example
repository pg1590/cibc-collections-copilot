# Export these in the backend terminal; the app does not load .env automatically.
# Defaults below are for a loopback-only synthetic-data demo.
COPILOT_ANALYST_PASSWORD=analyst-demo
COPILOT_AGENT_PASSWORD=agent-demo
COPILOT_SUPERVISOR_PASSWORD=supervisor-demo
# COPILOT_AGENT_ID=actual-agent-id-from-release
# COPILOT_DATASET=/absolute/path/maple_collections_release
# COPILOT_DB=/absolute/path/copilot.duckdb

# Optional Gemini adapter. With no key, the application stays local.
# Use a Google AI Studio Free-tier project; the app cannot verify billing tier.
# Keep keys out of Git/chat. The default key file is ignored data/gemini-key.txt.
# GEMINI_API_KEY=your-local-key
# GEMINI_API_KEY_FILE=/absolute/path/to/private-key-file
# COPILOT_GEMINI_ENABLED=0
# COPILOT_GEMINI_MODEL=gemini-3.5-flash-lite
# Alternative supported model: gemini-3.5-flash-lite
# COPILOT_GEMINI_TIMEOUT=15
# COPILOT_GEMINI_MAX_CALLS=60
# COPILOT_GEMINI_TEXT_EVIDENCE=0
# Note/transcript text remains local by default. Set 1 only to allow selected text.
# Timeout caps at 30 seconds; calls cap at 100 per service process/worker, not per day.
# Failures are not retried; requests use store=false and a bounded local cache.
# Free quota/billing and any provider charges must be checked in Google AI Studio.

# For Python commands on Windows, set PYTHONUTF8=1 in the terminal.

# Optional local speech-to-text: install requirements-voice.txt and run
# scripts/fetch_voice.py plus scripts/setup_voice.py. No API key is required.
# COPILOT_VOICE_MODEL=/absolute/path/to/prepared/voice-model
# Use one backend process; the bounded transcription queue is process-local.
